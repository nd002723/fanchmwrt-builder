#!/bin/sh

# Repository definitions belong to the new firmware. Refresh them before
# applying the configured mirror so old release paths cannot survive upgrade.
for repo_file in \
	/etc/apk/repositories.d/distfeeds.list \
	/etc/apk/repositories.d/customfeeds.list; do
	rom_repo_file="/rom$repo_file"
	[ -f "$rom_repo_file" ] || continue
	mkdir -p "${repo_file%/*}" || exit 1
	cp -f "$rom_repo_file" "$repo_file" || exit 1
	sed -i \
		's|https://downloads.openwrt.org|https://mirror.nju.edu.cn/openwrt|g' \
		"$repo_file" || exit 1
done

exit 0

