#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

start_service() {
	if [ ! -f /etc/extroot-sysupgrade/phase ] &&
		[ ! -f /etc/backup/installed_packages.txt ]; then
		uci -q show fstab | grep -q "\.target='\/overlay'" || return 0
	fi

	procd_open_instance
	procd_set_param command /usr/libexec/extroot-sysupgrade
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
