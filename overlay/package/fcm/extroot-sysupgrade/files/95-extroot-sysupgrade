#!/bin/sh

STATE_DIR=/etc/extroot-sysupgrade

[ ! -e "$STATE_DIR/phase" ] || exit 0

sections="$(uci -q show fstab | sed -n \
	"s/^fstab\.\([^.=]*\)\.target='\/overlay'$/\1/p")"
set -- $sections
[ "$#" -le 1 ] || {
	logger -t extroot-sysupgrade -- \
		"multiple /overlay mount sections are configured; refusing automatic migration"
	exit 1
}
[ "$#" -eq 1 ] || exit 0
section="$1"
uuid="$(uci -q get "fstab.$section.uuid")"
if [ -n "$uuid" ]; then
	case "$uuid" in
		*[!A-Fa-f0-9-]*)
			logger -t extroot-sysupgrade -- "invalid UUID configured for /overlay"
			exit 1
		;;
	esac
	devices="$(block info | sed -n \
		"s#^\([^:]*\):.* UUID=\"$uuid\".*#\1#p")"
	set -- $devices
	[ "$#" -le 1 ] || {
		logger -t extroot-sysupgrade -- \
			"the /overlay UUID resolves to multiple block devices; refusing automatic migration"
		exit 1
	}
	device="$1"
else
	device="$(uci -q get "fstab.$section.device")"
fi
actual="$(awk '$2 == "/overlay" { print $1; exit }' /proc/mounts)"
if [ -n "$device" ] && [ -n "$actual" ] &&
	[ "$(readlink -f "$device")" = "$(readlink -f "$actual")" ]; then
	exit 0
fi

mkdir -p "$STATE_DIR" || exit 1
printf '%s\n' "$section" > "$STATE_DIR/section" || exit 1
printf '%s\n' prepare > "$STATE_DIR/phase" || exit 1
logger -t extroot-sysupgrade -- \
	"initialized migration state after sysupgrade configuration restore"

exit 0
